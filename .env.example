# Development values only. Copy to .env and change locally if needed.
# Keep the actual .env untracked. These are not evaluation or production secrets.
ORGPILOT_POSTGRES_PASSWORD=localAdminOnly2026
ORGPILOT_MIGRATOR_PASSWORD=localMigratorOnly2026
ORGPILOT_API_PASSWORD=localApiOnly2026
ORGPILOT_WORKER_PASSWORD=localWorkerOnly2026
ORGPILOT_API_PORT=5080
ORGPILOT_POSTGRES_PORT=5432

# Optional development telemetry endpoint. External export is off by default.
ORGPILOT_OTLP_EXPORT_ENABLED=false
ORGPILOT_OTLP_ENDPOINT=http://127.0.0.1:4317

# Future evaluation model settings; not used by the Stage 1 Compose stack.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
